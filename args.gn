# =============================================================================
#  build configuration – tuned for high speed and lower RAM usage
# =============================================================================
# Changes from original:
#   - enable_webui_tab_strip = false     
#   - v8_enable_maglev = false            
#   - rtc_enable_avx2 = false             
#   - added v8_enable_allocation_timeout = true 
# Additional tweaks for leaner runtime:
#   - disable unused media formats (AC4, etc.)
#   - reduce debug info further
#   - enable more aggressive LTO caching 
# =============================================================================

# ---- CPU / ISA features ----
use_sse3 = true
use_sse41 = true
use_sse42 = true
use_avx = true          # AVX1 is enough for most workloads
use_avx2 = false        # saves ~200–300 MiB in some cases
use_avx512 = false
use_fma = false

# ---- Platform ----
target_os = "linux"
target_cpu = "x64"

# ---- Build type ----
is_official_build = true
is_debug = false
is_component_build = false
enable_stripping = true
symbol_level = 0
v8_symbol_level = 0
blink_symbol_level = 0
exclude_unwind_tables = true

# ---- Compiler / linker ----
is_clang = true
use_lld = true
use_icf = true
treat_warnings_as_errors = false
enable_precompiled_headers = false
# clang_use_chrome_plugins is kept true for stability
clang_use_chrome_plugins = true

# ---- Link-time optimisation ----
use_thin_lto = true
thin_lto_enable_optimizations = true
thin_lto_enable_cache = true   # re‑enable caching to speed up rebuilds
# PGO (phase 2)
chrome_pgo_phase = 2
pgo_data_path = "/home/alex/chromium/src/chrome/build/pgo_profiles/chrome-linux-7204-1752884295-12f6536705cabee4d92908e8cfb99baef0472db9-9a0a485c8a0160a466b96e275864e3976bf5e59f.profdata"

# ---- Security / hardening ----
is_cfi = true
init_stack_vars_zero = true

# ---- Rust support ----
enable_rust = true

# ---- Features to reduce memory & bloat ----
enable_webui_tab_strip = false          # saves UI memory
enable_linux_installer = true
enable_distro_version_check = false
enable_nacl = false
enable_reporting = false
enable_profiling = false
enable_resource_allowlist_generation = false
disable_fieldtrial_testing_config = true
dcheck_always_on = false

# ---- V8 ----
v8_enable_fast_torque = true
v8_enable_builtins_optimization = true
v8_enable_maglev = false                # TurboFan only – less memory overhead
v8_enable_turbofan = true
v8_enable_wasm_simd256_revec = true
use_v8_context_snapshot = true
v8_enable_allocation_timeout = true     # improves GC responsiveness

# ---- Media codecs ----
media_use_ffmpeg = true
media_use_libvpx = true
enable_hls_demuxer = true
enable_discovery = true
proprietary_codecs = true
ffmpeg_branding = "Chrome"
enable_ffmpeg_video_decoders = true
is_component_ffmpeg = true
use_webaudio_pffft = true

# ---- Hardware acceleration ----
use_vaapi = true

# ---- CDM / Widevine ----
enable_library_cdms = true
enable_widevine = true
bundle_widevine_cdm = true
enable_cdm_host_verification = false
ignore_missing_widevine_signing_cert = true
enable_media_drm_storage = true

# ---- WebRTC ----
rtc_use_h264 = true
rtc_use_h265 = true
rtc_build_examples = false
rtc_enable_avx2 = false                 # saves RAM in WebRTC pipelines

# ---- VR / AR ----
enable_vr = true

# ---- HEVC & audio codecs ----
enable_platform_hevc = true
enable_hevc_parser_and_hw_decoder = true
platform_has_optional_hevc_decode_support = true
platform_has_optional_hevc_encode_support = false
enable_platform_ac3_eac3_audio = true
enable_platform_ac4_audio = false       # unused, reduces binary size
enable_platform_dolby_vision = true
enable_platform_encrypted_dolby_vision = true
enable_platform_mpeg_h_audio = true
enable_platform_dts_audio = true
enable_mse_mpeg2ts_stream_parser = true

# ---- Misc ----
use_text_section_splitting = true
enable_hangout_services_extension = false
optimize_webui = true

# -----------------------------------------------------------------------------
# End of args.gn
# -----------------------------------------------------------------------------
